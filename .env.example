# ---------------------------------------------------------
# 🌐 Website
# ---------------------------------------------------------
# Public website origin used for canonical/Open Graph metadata.
# This is embedded at build time; use https://twelvecreative.io in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------
# 🌐 API
# ---------------------------------------------------------
# Server-side (RSC + server actions + middleware) — must reach the backend
API_URL=http://localhost:5000

# Shared only between Next.js and the backend. Never expose this as NEXT_PUBLIC_*.
# Use the same strong random value as the backend SERVER_API_KEY.
SERVER_API_KEY=

# Browser-side API base (backend routes are mounted under /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---------------------------------------------------------
# 🔐 Admin cookies (httpOnly, set by Next.js server actions)
# ---------------------------------------------------------
# Lifetime of the admin access cookie (mirrors backend JWT_ACCESS_SECRET_EXPIRES_IN)
ADMIN_ACCESS_COOKIE_MAX_AGE_SECONDS=86400
